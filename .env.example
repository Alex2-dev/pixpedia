# Pixpedia — variables d'environnement
# Copier en .env (jamais commité) puis remplir les valeurs.

# --- PostgreSQL (conteneur postgres du compose) ---
POSTGRES_USER=pixpedia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pixpedia
# Port exposé sur l'hôte (127.0.0.1 uniquement). 5432 est souvent déjà pris.
POSTGRES_PORT=5436

# URL utilisée par les commandes lancées depuis l'hôte (pnpm worker:import, pnpm db:migrate…).
# Dans les conteneurs, le compose la remplace par postgres:5432.
DATABASE_URL=postgres://pixpedia:change-me@localhost:5436/pixpedia

# --- IGDB (application Twitch : https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Limites IGDB : 4 requêtes/s, 8 requêtes en parallèle au maximum.
IGDB_RPS=4
IGDB_MAX_CONCURRENCY=8

# --- API ---
API_PORT=3014
# Origines autorisées en CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:5186

# --- Web ---
WEB_PORT=5186

# --- Worker ---
# Heure (0-23, heure du conteneur, UTC) de la synchronisation incrémentale quotidienne.
WORKER_SYNC_HOUR=4
